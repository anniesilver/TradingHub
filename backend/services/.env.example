# Database Configuration
# This database name should match what you created with: createdb tradinghub
DB_NAME=tradinghub
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Alternative: Full database URL (overrides above settings if set)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/tradinghub

# IBKR Configuration
# IB Gateway (paper) runs in Docker on the trade-engine server and only listens on the
# server's own 127.0.0.1:4002. Reach it from this machine through an SSH tunnel:
#   ssh -N -L 4002:localhost:4002 <user>@trade-engine.local
# then keep IBKR_HOST=127.0.0.1 and IBKR_PORT=4002.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=123

# Auto refresh data flag
AUTO_REFRESH_DATA=true

# Flask Configuration (optional - for production)
# SECRET_KEY=your-super-secret-key-change-in-production
# JWT_SECRET_KEY=your-jwt-secret-key-change-in-production